# Public site deployment configuration (SPEC.md §6.1)
# Each public site deployment serves exactly one hostel.
# Paste the row _id from the hostels table in the Convex dashboard.
HOSTEL_ID=

# Public Convex deployment URL — live rooms, prices, availability, inquiries.
NEXT_PUBLIC_CONVEX_URL=

# Which static shell this deployment renders before live Convex data merges
# on top (lib/<slug>-hostel.ts). Dev default: aseda-heights.
# Franco Hostel preview: franco-hostel
HOSTEL_SLUG=

