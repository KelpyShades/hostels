# Dashboard deployment configuration
# Each dashboard deployment serves exactly one hostel.
# Paste the row _id from the hostels table in the Convex dashboard.
HOSTEL_ID=

# Public Convex deployment URL used by the manager dashboard.
NEXT_PUBLIC_CONVEX_URL=

# The public website URL this dashboard's hostel serves — powers the
# Share view's QR code and copy-link (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Branch-scoped caretaker deployment (optional, FR-B6): paste a branch _id
# to lock this dashboard to one branch — the caretaker sees only their
# branch's enquiries, rooms and share link. Unset = the owner/manager view.
NEXT_PUBLIC_BRANCH_ID=

